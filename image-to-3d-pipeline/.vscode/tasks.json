{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Verify Installation",
            "type": "shell",
            "command": "python verify_installation.py",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Process Batch",
            "type": "shell",
            "command": "python image_to_3d.py --batch",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Install Dependencies",
            "type": "shell",
            "command": "pip install -r requirements.txt",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "View Batch Report",
            "type": "shell",
            "command": "cat output/reports/batch_report.csv",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
